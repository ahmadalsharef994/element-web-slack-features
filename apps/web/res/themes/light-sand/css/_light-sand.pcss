/* Sand: the light theme on a warm paper canvas with a burnt-orange accent instead of green.
   Success states keep the green scale; only the accent tokens move to orange. */
$accent-100: var(--cpd-color-orange-100);
$accent-200: var(--cpd-color-orange-200);
$accent-300: var(--cpd-color-orange-300);
$accent-400: var(--cpd-color-orange-400);
$accent-500: var(--cpd-color-orange-500);
$accent-600: var(--cpd-color-orange-600);
$accent-700: var(--cpd-color-orange-700);
$accent-800: var(--cpd-color-orange-800);
$accent-900: var(--cpd-color-orange-900);
$accent-1000: var(--cpd-color-orange-1000);
$accent-1100: var(--cpd-color-orange-1100);
$accent-1200: var(--cpd-color-orange-1200);
$accent-1300: var(--cpd-color-orange-1300);
$accent-1400: var(--cpd-color-orange-1400);
$eventbubble-self-bg: var(--cpd-color-orange-300);

/* Compound primitives live in a lower cascade layer, so these win. Ratios checked against WCAG AA. */
.cpd-theme-light {
    --cpd-color-theme-bg: #fbf9f6;
    --cpd-color-gray-100: #f8f5f1;
    --cpd-color-gray-200: #f4f1ec;
    --cpd-color-gray-300: #ede9e3;
    --cpd-color-gray-400: #e0dbd3;
    --cpd-color-gray-500: #cec8bf;
    --cpd-color-gray-600: #bfb8ae;
    --cpd-color-gray-700: #a8a097;
    --cpd-color-gray-800: #858077;
    --cpd-color-gray-900: #67625b;
    --cpd-color-gray-1000: #5b5650;
    --cpd-color-gray-1100: #4e4a45;
    --cpd-color-gray-1200: #3e3b37;
    --cpd-color-gray-1300: #2d2b28;
    --cpd-color-gray-1400: #1d1c1a;
    --cpd-color-bg-accent-rest: var(--cpd-color-orange-900);
    --cpd-color-bg-accent-hovered: var(--cpd-color-orange-1000);
    --cpd-color-bg-accent-pressed: var(--cpd-color-orange-1100);
    --cpd-color-bg-badge-accent: var(--cpd-color-orange-400);
    --cpd-color-border-accent-primary: var(--cpd-color-orange-900);
    --cpd-color-border-accent-subtle: var(--cpd-color-orange-700);
    --cpd-color-icon-accent-primary: var(--cpd-color-orange-900);
    --cpd-color-icon-accent-tertiary: var(--cpd-color-orange-800);
    --cpd-color-text-action-accent: var(--cpd-color-orange-900);
    --cpd-color-text-badge-accent: var(--cpd-color-orange-1100);
    --cpd-color-gradient-action-stop1: var(--cpd-color-orange-500);
    --cpd-color-gradient-action-stop2: var(--cpd-color-orange-700);
    --cpd-color-gradient-action-stop3: var(--cpd-color-orange-900);
    --cpd-color-gradient-action-stop4: var(--cpd-color-orange-1100);
}
